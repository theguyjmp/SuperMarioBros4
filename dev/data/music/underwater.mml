# Underwater - gentle 3/4 waltz in F major with a big wet echo. Opens with the "Hop Along" main motif as a slow
# waltz (bars 1-8), then drifts on. 24-bar loop (every bar = 3 quarters):
# A  F F Dm Dm | Gm Gm C7 C      A' F A7 Dm Dm | Bb Bbm F C7      B  Dm Am Bb F | Gm C7 Db Eb  (-> F: bVI-bVII-I)
# Flute lead, vibes counter-line, quiet string pad, rolling harp arpeggios, waltz bass + e-piano, glock bubbles.
tempo 120
title Tidepool Waltz
echo 7 60 45
swing 50

# ---------------- C1: flute lead ----------------
C1: @flute v11 p0 q8 E1 V2
C1: L
C1: o5 c4 f4 a4 | o6 c4. o5 a8 f4 | o6 d2 c4 | o5 a2 f8 g8 |
C1: o5 b-4 o6 d4 f4 | o6 d4. c8 o5 b-4 | o6 c2 o5 g4 | o5 a2. |
C1: o5 a4 o6 c4 f4 | o6 e2 c+4 | o6 d4 c4 o5 a4 | o5 f2 a4 |
C1: o5 b-4 o6 d4 f4 | o6 f2 d-4 | o6 c4 o5 a4 f4 | o5 e4 g4 b-4 |
C1: o5 a2. | o5 e4 a4 o6 c4 | o6 d2. | o6 c4 o5 a4 f4 |
C1: o5 g2 b-4 | o5 b-4 o6 c4 e4 | o5 a-4 o6 d-4 f4 | o5 b-2 g4 |

# ---------------- C2: vibes counter-line ----------------
C2: @vibes v7 p-4 q8 E1
C2: L
C2: o4 a2. | o4 a4 b-4 o5 c4 | o4 f2. | o4 f4 e4 d4 |
C2: o5 d2. | o4 b-4 o5 c4 d4 | o4 b-2 e4 | o4 e4 f4 g4 |
C2: o5 c2. | o5 c+4 d4 e4 | o5 f2. | o4 a4 b-4 o5 c4 |
C2: o5 d2. | o5 d-4 c4 o4 b-4 | o4 a2. | o5 c2. |
C2: o5 f4 e4 d4 | o5 c2. | o4 b-4 o5 d4 f4 | o4 a2. |
C2: o4 b-4 o5 d4 g4 | o5 c2. | o5 f4 a-4 o6 d-4 | o5 g2 e-4 |

# ---------------- C3: quiet string pad ----------------
C3: @strings v5 p3 q8 E1
C3: L
C3: o4 {c f a}2. | {c f a}2. | {d f a}2. | {d f a}2. |
C3: o4 {d g b-}2. | {d g b-}2. | {e g b-}2. | {c e g}2. |
C3: o4 {c f a}2. | {c+ e g}2. | {d f a}2. | {d f a}2. |
C3: o4 {d f b-}2. | {d- f b-}2. | {c f a}2. | {e g b-}2. |
C3: o4 {d f a}2. | {c e a}2. | {d f b-}2. | {c f a}2. |
C3: o4 {d g b-}2. | {e g b-}2. | {d- f a-}2. | {e- g b-}2. |

# ---------------- C4: rolling harp arpeggios ----------------
C4: @harp v7 p5 q8 E1
C4: L
C4: o3 f8 o4 c8 f8 a8 o5 c8 o4 a8 | o3 f8 o4 c8 f8 a8 o5 c8 o4 a8 |
C4: o3 d8 a8 o4 d8 f8 a8 f8 | o3 d8 a8 o4 d8 f8 a8 f8 |
C4: o3 g8 o4 d8 g8 b-8 o5 d8 o4 b-8 | o3 g8 o4 d8 g8 b-8 o5 d8 o4 b-8 |
C4: o3 c8 g8 o4 c8 e8 b-8 e8 | o3 c8 g8 o4 c8 e8 g8 e8 |
C4: o3 f8 o4 c8 f8 a8 o5 c8 o4 a8 | o3 a8 o4 c+8 e8 g8 a8 e8 |
C4: o3 d8 a8 o4 d8 f8 a8 f8 | o3 d8 a8 o4 d8 f8 a8 f8 |
C4: o3 b-8 o4 d8 f8 b-8 o5 d8 o4 b-8 | o3 b-8 o4 d-8 f8 b-8 o5 d-8 o4 b-8 |
C4: o3 f8 o4 c8 f8 a8 o5 c8 o4 a8 | o3 c8 g8 o4 c8 e8 b-8 e8 |
C4: o3 d8 a8 o4 d8 f8 a8 f8 | o3 a8 o4 c8 e8 a8 o5 c8 o4 a8 |
C4: o3 b-8 o4 d8 f8 b-8 o5 d8 o4 b-8 | o3 f8 o4 c8 f8 a8 o5 c8 o4 a8 |
C4: o3 g8 o4 d8 g8 b-8 o5 d8 o4 b-8 | o3 c8 g8 o4 c8 e8 b-8 e8 |
C4: o3 d-8 a-8 o4 d-8 f8 a-8 f8 | o3 e-8 b-8 o4 e-8 g8 b-8 g8 |

# ---------------- C5: waltz bass ----------------
C5: @bass v11 p0 q7 E0
C5: L
C5: o2 f2 o3 c4 | o2 f2 o3 c4 | o2 d2 a4 | o2 d2 a4 |
C5: o2 g2 o3 d4 | o2 g2 o3 d4 | o2 c2 g4 | o2 c2 g4 |
C5: o2 f2 o3 c4 | o2 a2 o3 e4 | o2 d2 a4 | o2 d2 a4 |
C5: o2 b-2 o3 f4 | o2 b-2 o3 f4 | o2 f2 o3 c4 | o2 c2 g4 |
C5: o2 d2 a4 | o2 a2 o3 e4 | o2 b-2 o3 f4 | o2 f2 o3 c4 |
C5: o2 g2 o3 d4 | o2 c2 g4 | o2 d-2 a-4 | o2 e-2 b-4 |

# ---------------- C6: soft kick + shaker ----------------
C6: @kit v9
C6: L
C6: [[k4 j4 j4]7 k4 j4 j8 j8]3 |

# ---------------- C7: glockenspiel bubbles ----------------
C7: @glock v7 p-6 q8 E1
C7: L
C7: r2. | r4 o6 c8 f8 a8 o7 c8 | r2. | r4 o6 d8 f8 a8 o7 d8 |
C7: r2. | r4 o6 d8 g8 b-8 o7 d8 | r2. | r4 o6 c8 e8 g8 o7 c8 |
C7: r2. | r4 o6 c+8 e8 g8 a8 | r2. | r4 o6 d8 f8 a8 o7 d8 |
C7: r2. | r4 o6 d-8 f8 b-8 o7 d-8 | r2. | r4 o6 e8 g8 b-8 o7 c8 |
C7: r2. | r4 o6 c8 e8 a8 o7 c8 | r2. | r4 o6 c8 f8 a8 o7 c8 |
C7: r2. | r4 o6 e8 g8 b-8 o7 c8 | r2. | r4 o6 e-8 g8 b-8 o7 e-8 |

# ---------------- C8: e-piano "pah-pah" on beats 2 and 3 ----------------
C8: @epiano v6 p-2 q5 E1
C8: L
C8: o4 r4 {a > c}4 {a > c}4 | r4 {a > c}4 {a > c}4 | r4 {f a}4 {f a}4 | r4 {f a}4 {f a}4 |
C8: o4 r4 {b- > d}4 {b- > d}4 | r4 {b- > d}4 {b- > d}4 | r4 {g b-}4 {g b-}4 | r4 {e g}4 {e g}4 |
C8: o4 r4 {a > c}4 {a > c}4 | r4 {c+ g}4 {c+ g}4 | r4 {f a}4 {f a}4 | r4 {f a}4 {f a}4 |
C8: o4 r4 {b- > d}4 {b- > d}4 | r4 {b- > d-}4 {b- > d-}4 | r4 {a > c}4 {a > c}4 | r4 {g b-}4 {g b-}4 |
C8: o4 r4 {f a}4 {f a}4 | r4 {e a}4 {e a}4 | r4 {b- > d}4 {b- > d}4 | r4 {a > c}4 {a > c}4 |
C8: o4 r4 {b- > d}4 {b- > d}4 | r4 {g b-}4 {g b-}4 | r4 {a- > d-}4 {a- > d-}4 | r4 {g b-}4 {g b-}4 |
