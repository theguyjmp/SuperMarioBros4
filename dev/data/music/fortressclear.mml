# Fortress clear (~4 s) - the motif in D MINOR as a snappy trumpet call, a rising run over bVI - bVII (B-flat, C),
# then it turns to D MAJOR (Picardy) with a brass ta-da, xylo doubling, tuba and timpani.
tempo 144
title Fortress Cleared
loop 0
echo 7 45 32

# ---------------- C1: trumpet ----------------
C1: @trumpet v12 p0 q6 E1 V0
C1: o4 a8 o5 d8 r8 f8 r8 a8 f8 d8 | o5 f16 b-16 o6 d16 f16 d8 o5 b-8 g16 o6 c16 e16 g16 e8 c8 | q8 V1 o6 f+2 |

# ---------------- C2: brass stabs ----------------
C2: @brass v10 p-4 q3 E1
C2: o4 r4 {f a > d}8 r8 {f a > d}8 r8 r4 | o4 {f b- > d}8 r8 {f b- > d}8 r8 {g > c e}8 r8 {g > c e}8 r8 | q8 o4 {a > d f+}2 |

# ---------------- C3: low strings ----------------
C3: @strings v5 p4 q8 E1
C3: o4 {d f a}1 | o4 {d f b-}2 {e g > c}2 | o4 {f+ a > d}2 |

# ---------------- C4: xylo doubling, glock ta-da ----------------
C4: @xylo v5 p5 q5 E1
C4: o5 a8 o6 d8 r8 f8 r8 a8 f8 d8 | o6 f16 b-16 o7 d16 f16 d8 o6 b-8 g16 o7 c16 e16 g16 e8 c8 |
C4: @glock v7 p5 q8 E1
C4: o6 d16 f+16 a16 o7 d16 ^4 |

# ---------------- C5: tuba ----------------
C5: @tuba v12 p0 q5 E0
C5: o2 d4 o1 a4 o2 d4 o1 a4 | o1 b-4 o2 f4 c4 g4 | q8 o2 d2 |

# ---------------- C6: kick / rim / snare fill ----------------
C6: @kit v11
C6: k4 d4 k8 k8 d4 | k8 s16 s16 s8 s16 s16 k8 s16 s16 s8 s8 | x2 |

# ---------------- C7: shaker + woodblock, crash ----------------
C7: @kit v9
C7: i8 j8 j8 i8 j8 j8 i8 j8 | j8 j8 i8 j8 j8 j8 i8 i8 | v11 c2 |

# ---------------- C8: timpani ----------------
C8: @timpani v11 p-2 q8 E1
C8: o3 d4 r4 o2 a4 r4 | o2 b-4 b-8 b-8 o3 c8 c8 o2 [a32]8 | o3 d2 |
