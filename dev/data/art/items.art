# Items & effects - original 16-bit style pixel art (generated from material maps: 1-px dark outline,
# 3-4 step ramps lit from the top-left). Slot plans are listed per palette; keep them when editing.
# mushroom/oneup: 1 outline, 2-5 cap ramp, 6-9 white spots, 10-13 stalk, 14 eyes, 15 glint
pal mushroom #301018 #F8A090 #E83830 #B01820 #700818 #FFFFFF #F0ECE8 #C8C0D0 #9088A8 #FFF4D8 #F0D8A8 #D0A870 #986840 #281818 #FFFFFF
pal oneup #102010 #B8F898 #48C040 #208028 #0C4818 #FFFFFF #F0ECE8 #C8C0D0 #9088A8 #FFF4D8 #F0D8A8 #D0A870 #986840 #281818 #FFFFFF
# flower: 1 outline, 2-5 stem/leaf greens, 6-9 petal ramp, 10-13 center ramp, 14 eyes
pal flower #281008 #B0F078 #50C038 #208828 #0C5018 #F8C088 #F86830 #D02818 #881010 #FFFFF0 #F8F080 #E8C040 #B08020 #301010
# flower.2: the alternate flashing colors (same slot plan)
pal flower.2 #281008 #B0F078 #50C038 #208828 #0C5018 #FFF8C8 #F8D050 #E09820 #985010 #FFFFFF #F8B0A0 #F06848 #B82820 #301010
# leaf: 1 outline, 2-5 leaf ramp, 6 vein, 7-8 stem
pal leaf #401808 #F8E898 #F8B848 #E07818 #A04810 #C05818 #905828 #603818
# star (+ star.2..4 invincibility flash cycle): 1 outline, 2-5 body ramp, 6 eyes, 7 glint
pal star #503000 #FFFFD8 #F8E860 #F0B820 #B87810 #301808 #FFFFFF
pal star.2 #581800 #FFF0D0 #F8B060 #F07020 #B04010 #301008 #FFFFFF
pal star.3 #083010 #F0FFD8 #98F080 #38C048 #188028 #082010 #FFFFFF
pal star.4 #500818 #FFE8F0 #F898B8 #E84878 #A01840 #300810 #FFFFFF
# coin (also key): 1 outline, 2 glint, 3-6 gold ramp
pal coin #502800 #FFFFE8 #F8E868 #F0B828 #C87810 #884808
# pswitch: 1 outline, 2-5 blue ramp, 6-7 letter, 8-10 steel base
pal pswitch #081028 #90C0F8 #3870E0 #2040A8 #101868 #FFFFFF #C8D0E8 #E0E0E8 #9898B0 #585870
# fireball: 1 dark rim, 2 red, 3 orange, 4 yellow, 5 white core
pal fireball #901000 #E83810 #F89030 #F8E058 #FFFFF0
# hammer: 1 outline, 2-5 steel ramp, 6-8 wood handle
pal hammer #181820 #F8F8FF #B8B8C8 #787890 #404050 #F8C888 #C88040 #804820
# fx (puffs, dust, sparkles, tiny score digits): 1 dark, 2 white, 3 light gray, 4 gray, 5 pale yellow, 6 gold, 7 orange, 8 cyan
pal fx #282838 #FFFFFF #D8D8E8 #9898B0 #FFF8B0 #F8C830 #F07820 #A0E8F8
# orb / card (fortress "?" crystal ball): 1 outline, 2-5 glass ramp, 6-7 mark, 8 glint
pal card #100828 #D0C8FF #9880F0 #6040D0 #301890 #FFFFFF #D8D0F0 #FFFFFF
pal orb #100828 #D0C8FF #9880F0 #6040D0 #301890 #FFFFFF #D8D0F0 #FFFFFF
# hud: 1 dark, 2 white, 3 red, 4 gold, 5 blue, 6 green, 7 gray
pal hud #101018 #FFFFFF #E83030 #F8C830 #3870E0 #40C040 #9898B0
# vine.sprout: 1 outline, 2-5 leaf ramp, 6-7 stem
pal vine.sprout #082808 #B8F878 #58C838 #289028 #106018 #70B030 #3C7818
# preview-only palettes (the engine draws debris/splash with the theme brick/water palette: slots 1-3 only)
pal prev.brick #301008 #B85828 #F0A868
pal prev.water #102868 #58A8F0 #E8F8FF

