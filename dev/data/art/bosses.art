# Bosses - original 16-bit style pixel art (all face RIGHT), generated from material maps: 1-px dark outline,
# inner outlines where body parts overlap, 3-4 step ramps lit from the top-left.
# boomboom: 1 outline, 2-5 skin, 6-9 shell, 10-12 ivory (spikes/belly/teeth), 13 eye white, 14-15 mouth
pal boomboom #200808 #F8E0A8 #E8A860 #C07838 #7C4420 #98C8A8 #508870 #305848 #183028 #FFFFF0 #E8D8A8 #B09868 #FFFFFF #D83028 #701818
pal boomboom.flash #480808 #FFFFFF #FFE8E8 #F8C8C8 #E8A0A0 #FFFFFF #FFE8E8 #F8C8C8 #E8A0A0 #FFFFFF #FFE8E8 #F8C8C8 #FFFFFF #F86060 #C03030
# koopaling (+ koopaling.NAME per world, koopaling.flash): 1 outline, 2-5 shell/signature ramp, 6-9 skin,
# 10-12 ivory (belly, shell rim, spikes, claws), 13 eye white, 14 mouth
pal koopaling #181018 #A8E8F8 #48A8E0 #2868A8 #143868 #F8F0B8 #E8D068 #B89838 #705818 #FFF8E0 #D8C898 #988860 #FFFFFF #D84848
pal koopaling.lemmy #181018 #A8E8F8 #48A8E0 #2868A8 #143868 #F8F0B8 #E8D068 #B89838 #705818 #FFF8E0 #D8C898 #988860 #FFFFFF #D84848
pal koopaling.roy #181018 #F8A8E8 #D050B8 #902880 #501048 #F8F0B8 #E8D068 #B89838 #705818 #FFF8E0 #D8C898 #988860 #FFFFFF #D84848
pal koopaling.iggy #181018 #C0F8A0 #58C840 #288828 #104818 #F8F0B8 #E8D068 #B89838 #705818 #FFF8E0 #D8C898 #988860 #FFFFFF #D84848
pal koopaling.wendy #181018 #F8C0D8 #F07098 #B83868 #681838 #F8F0B8 #E8D068 #B89838 #705818 #FFF8E0 #D8C898 #988860 #FFFFFF #D84848
pal koopaling.morton #181018 #D8D8E0 #9090A0 #585868 #303040 #F8D8A0 #D8A058 #A06830 #603818 #FFF8E0 #D8C898 #988860 #FFFFFF #D84848
pal koopaling.larry #181018 #A0C8F8 #4878E8 #2848B0 #101C60 #F8F0B8 #E8D068 #B89838 #705818 #FFF8E0 #D8C898 #988860 #FFFFFF #D84848
pal koopaling.ludwig #181018 #8898E8 #3848B8 #202880 #101040 #F8F0B8 #E8D068 #B89838 #705818 #FFF8E0 #D8C898 #988860 #FFFFFF #D84848
pal koopaling.flash #401828 #FFFFFF #FFFFFF #E8E8F8 #C0C0D8 #FFFFFF #FFFFFF #E8E8F8 #C0C0D8 #FFFFFF #E8E8F8 #C0C0D8 #FFFFFF #F8A0A0
# bowser: 1 outline, 2-5 skin, 6-8 shell, 9-10 belly/rim, 11-13 mane (also mouth), 14-15 ivory (horns, spikes, claws, eye)
pal bowser #181008 #F8E888 #E8B838 #B07C18 #6C4408 #90D878 #38A040 #1C6030 #FFF8E0 #D0B888 #F88850 #E03018 #881010 #FFFFF0 #B8B098
# bowser.hair is kept for older code paths (same colors: the mane now has its own slots 11-13)
pal bowser.hair #181008 #F8E888 #E8B838 #B07C18 #6C4408 #90D878 #38A040 #1C6030 #FFF8E0 #D0B888 #F88850 #E03018 #881010 #FFFFF0 #B8B098
pal bowser.flash #401010 #FFFFFF #FFFFFF #F0E8E8 #D0C0C0 #FFFFFF #F0E8E8 #D0C0C0 #FFFFFF #F0E8E8 #FFFFFF #F8D0C8 #E0A8A0 #FFFFFF #D0C0C0
# bowserfire: 1 dark red rim, 2 red, 3 orange, 4 yellow, 5 white core
pal bowserfire #A01000 #E84010 #F89030 #F8D860 #FFFFE8
# ring.a / ring.b (magic ring flash pair): 1 outline, 2 white, 3 light, 4 mid, 5 accent
pal ring.a #182060 #FFFFFF #98E8F8 #3890E0 #F870C8
pal ring.b #501040 #FFFFFF #F8B0E8 #D048A0 #88E0F8
# wand: 1 outline, 2-4 gold, 5 glint, 6-7 gem
pal wand #201008 #FFF8C0 #F0C040 #A87018 #FFFFFF #F868A8 #A01858

