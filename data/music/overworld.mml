# Overworld - the main level theme (signature tune). C major, shuffle feel, bouncy.
# 2-bar intro, then a 24-bar loop: A (hook) - B (lift to F/G/Em/Am) - A' (hook with marimba harmony, cadence).
tempo 144
title Hop Along Hills
echo 5 35 28
swing 58

# ---------------- C1: lead (chorused pulse lead) ----------------
C1: @lead v12 p0 q7 E1 V1
C1: r1 | r2 r8 o4 d8 e8 f8 |
C1: L
# A
C1: o4 g8 o5 c8 r8 e8 r8 g8 e8 c8 | o5 a4 g8 e8 ^4 c8 d8 |
C1: o5 f8 a8 r8 o6 c8 r8 o5 a8 g8 f8 | o5 g4 d8 e8 ^4 r8 o4 g8 |
C1: o4 g8 o5 c8 r8 e8 r8 g8 o6 c8 o5 b8 | o5 a4 e8 c8 ^4 o4 a8 b8 |
C1: o5 c8 d8 f8 a8 g8 f8 d8 o4 b8 | o5 c2 ^8 r8 r4 |
# B
C1: o5 a4. f8 c8 f8 a8 o6 c8 | o5 b4. g8 d8 g8 b8 o6 d8 |
C1: o6 e4 d8 o5 b8 g4 e8 g8 | o5 a2 ^8 g8 a8 b8 |
C1: o6 c4 o5 a8 f8 ^4 d8 f8 | o5 g4 b8 o6 d8 ^4 c8 o5 b8 |
C1: o5 c8 e-8 a-8 e-8 d8 f8 b-8 f8 | o5 e4 c4 r4 o4 d8 f8 |
# A'
C1: o4 g8 o5 c8 r8 e8 r8 g8 e8 c8 | o5 a4 g8 e8 ^4 c8 d8 |
C1: o5 f8 a8 r8 o6 c8 r8 o5 a8 g8 f8 | o5 g4 d8 e8 ^4 r8 o4 g8 |
C1: o4 g8 o5 c8 r8 e8 r8 g8 o6 c8 o5 b8 | o5 a4 e8 c8 ^4 o4 a8 b8 |
C1: o5 d8 f8 a8 o6 c8 o5 b8 g8 a8 b8 | o6 c4 o5 g8 e8 c4 r4 |

# ---------------- C2: counter-melody (flute in B, marimba harmony in A') ----------------
C2: r1 | r1 |
C2: L
C2: [r1]8 |
C2: @flute v9 p-4 q7 E1 V2
C2: o5 c2 o4 a2 | o5 d2 o4 b2 | o5 g2 e2 | o5 e2 c4 e4 |
C2: o5 f2 d2 | o5 d2 o4 b4 o5 d4 | o5 e-2 f2 | o5 e2 g2 |
C2: @marimba v9 p-4 q6 E1 V0
C2: o4 e8 g8 r8 o5 c8 r8 e8 c8 o4 g8 | o5 e4 e8 c8 ^4 o4 a8 b8 |
C2: o5 c8 f8 r8 a8 r8 f8 e8 d8 | o4 b4 b8 o5 c8 ^4 r8 o4 d8 |
C2: o4 e8 g8 r8 o5 c8 r8 e8 g8 g8 | o5 e4 c8 o4 a8 ^4 e8 g8 |
C2: o4 a8 o5 d8 f8 a8 g8 d8 f8 g8 | o5 e4 e8 c8 o4 g4 r4 |

# ---------------- C3: string pad (3-note chords) ----------------
