C3: r1 | o3 {g b > d}1 |
C3: L
C3: o4 {c e g}1 | {c e a}1 | {c f a}1 | o3 {b > d g}1 |
C3: o4 {c e g}1 | {c e a}1 | {d f a}2 o3 {b > d g}2 | o4 {c e g}1 |
C3: o4 {c f a}1 | o3 {b > d g}1 | o3 {b > e g}1 | o4 {c e a}1 |
C3: o4 {d f a}1 | o3 {b > d g}1 | o4 {c e- a-}2 {d f b-}2 | o4 {c e g}1 |
C3: o4 {c e g}1 | {c e a}1 | {c f a}1 | o3 {b > d g}1 |
C3: o4 {c e g}1 | {c e a}1 | {d f a}2 o3 {b > d g}2 | o4 {c e g}1 |

