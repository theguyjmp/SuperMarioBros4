# World 4 map - Jungle. Syncopated ocarina "Hop Along" motif over a marimba 3+3+2 ostinato, congas and bongos.
# Written in C, sounds in G (K7). 12-bar loop: C | Am | F | G | C | A7 | D7 | G7 | F | Fm | Ab Bb | C
tempo 124
title Vine Trail
echo 5 40 28
swing 50

# ---------------- C1: lead (ocarina) ----------------
C1: @ocarina v12 p0 q6 E1 V1 K7
C1: L
C1: o4 g8 o5 c8 r8 e8 r8 g8 e8 c8 | o5 a4 g8 e8 ^4 c8 d8 |
C1: o5 c8 f8 ^8 f8 a8 ^8 f8 r8 | o5 d8 g8 ^8 g8 b8 ^8 g8 r8 |
C1: o5 e8 g8 ^8 g8 o6 c8 ^8 o5 g8 e8 | o5 c+8 e8 ^8 a8 g8 e8 c+8 o4 a8 |
C1: o5 d8 f+8 ^8 a8 o6 c8 o5 a8 f+8 d8 | o5 g4 f8 d8 o4 b4 r4 |
C1: o5 a8 r8 a8 o6 c8 ^8 o5 a8 f8 r8 | o5 a-8 r8 a-8 o6 c8 ^8 o5 a-8 f8 r8 |
C1: o5 e-8 a-8 o6 c8 e-8 d8 o5 b-8 f8 d8 | o5 e8 g8 o6 c4 r2 |

# ---------------- C2: marimba ostinato (3+3+2) ----------------
C2: @marimba v9 p-4 q5 E1 K7
C2: L
C2: o4 e8 g8 >c8< e8 g8 >c8< e8 g8 | e8 a8 >c8< e8 a8 >c8< e8 a8 | f8 a8 >c8< f8 a8 >c8< f8 a8 | g8 b8 >d8< g8 b8 >d8< g8 b8 |
C2: o4 e8 g8 >c8< e8 g8 >c8< e8 g8 | e8 g8 >c+8< e8 g8 >c+8< e8 g8 | f+8 a8 >c8< f+8 a8 >c8< f+8 a8 | g8 b8 >f8< g8 b8 >f8< g8 b8 |
C2: o4 f8 a8 >c8< f8 a8 >c8< f8 a8 | f8 a-8 >c8< f8 a-8 >c8< f8 a-8 | e-8 a-8 >c8< e-8 f8 b-8 >d8< f8 | e8 g8 >c8< e8 g8 >c8< e8 g8 |

# ---------------- C3: string pad (quiet) ----------------
C3: @strings v5 p4 q8 E1 K7
C3: L
C3: o4 {c e g}1 | {c e a}1 | {c f a}1 | o3 {b > d g}1 |
C3: o4 {c e g}1 | {c+ e g}1 | {c f+ a}1 | o3 {b > d f}1 |
C3: o4 {c f a}1 | {c f a-}1 | {c e- a-}2 {d f b-}2 | {c e g}1 |

# ---------------- C4: guitar off-beat chops ----------------
C4: @guitar v7 p5 q3 E0 K7
C4: L
C4: o4 [r8 {e g > c}8]4 | [r8 {e a > c}8]4 | [r8 {f a > c}8]4 | [r8 {d g b}8]4 |
C4: o4 [r8 {e g > c}8]4 | [r8 {e g > c+}8]4 | [r8 {f+ a > c}8]4 | [r8 {d f b}8]4 |
C4: o4 [r8 {f a > c}8]4 | [r8 {f a- > c}8]4 | [r8 {e- a- > c}8]2 [r8 {d f b-}8]2 | [r8 {e g > c}8]4 |

# ---------------- C5: bouncing octave bass ----------------
C5: @slapbass v11 p0 q5 E0 K7
C5: L
C5: o2 c8 r8 >c8< c8 r8 c8 >c8< c8 | o1 a8 r8 >a8< a8 r8 a8 >a8< a8 | o1 f8 r8 >f8< f8 r8 f8 >f8< f8 | o1 g8 r8 >g8< g8 r8 g8 >g8< g8 |
C5: o2 c8 r8 >c8< c8 r8 c8 >c8< c8 | o1 a8 r8 >a8< a8 r8 a8 >a8< a8 | o2 d8 r8 >d8< d8 r8 d8 >d8< d8 | o1 g8 r8 >g8< g8 r8 g8 a8 b8 |
C5: o1 f8 r8 >f8< f8 r8 f8 >f8< f8 | o1 f8 r8 >f8< f8 r8 f8 >f8< g8 | o1 a-8 r8 >a-8< a-8 b-8 r8 >b-8< b8 | o2 c8 r8 >c8< c8 r8 c8 >c8< c8 |

# ---------------- C6: kick + congas ----------------
C6: @kit v11
C6: L
C6: [[k8 r8 f8 g8 k8 f8 g8 f8]5 k8 f8 g8 f8 t8 t8 m8 u8]2 |

# ---------------- C7: bongos, woodblock, shaker ----------------
C7: @kit v8
C7: L
C7: [z16 z16 b8 i8 z8 z16 z16 b8 j8 z8]12 |

# ---------------- C8: xylophone bird calls ----------------
C8: @xylo v7 p-6 q5 E1 K7
C8: L
C8: r1 | r1 | r1 | r2 r4 o6 d16 e16 d8 | r1 | r1 | r1 | r2 r4 o6 f16 g16 f8 |
C8: r1 | r1 | r1 | r2 o6 e16 g16 e8 r4 |
